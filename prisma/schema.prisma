// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Пользователь телеграм бота
model User {
  id         String   @id @default(cuid())
  telegramId String   @unique
  username   String?
  firstName  String?
  lastName   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Связи
  subscription Subscription[]
  userProgress UserProgress[]
  userAnswers  UserAnswer[]

  @@map("users")
}

// Программы обучения
model Program {
  id            String      @id @default(uuid())
  name          String      @unique // "Мок-собеседование", "Изучение по темам"
  description   String? // Описание программы
  callback_data String?
  type          ProgramType // Тип программы
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  order         Int         @default(0)

  // Связи
  categories Category[]

  @@map("programs")
}

// Категории (HTTP/HTTPS, браузер, HTML, CSS, React и т.д.)
model Category {
  id            String   @id @default(uuid())
  name          String   @unique // "React", "HTML", "CSS", "HTTP/HTTPS", "Браузер"
  description   String? // Описание категории
  icon          String? // Эмодзи для категории
  callback_data String?
  isActive      Boolean  @default(true)
  order         Int // Порядок отображения
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Связи
  programId String
  program   Program @relation(fields: [programId], references: [id])

  subcategories Subcategory[]
  questions     Question[]
  userProgress  UserProgress[]

  @@map("categories")
}

// Подтемы (хуки, состояния, рендеринг и т.д.)
model Subcategory {
  id            String   @id @default(uuid())
  name          String // "Хуки", "Состояние", "Рендеринг", "Компоненты"
  description   String? // Описание подтемы
  isActive      Boolean  @default(true)
  order         Int // Порядок отображения
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  callback_data String?
  // Связи
  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id])

  questions    Question[]
  userProgress UserProgress[]

  @@unique([categoryId, name])
  @@map("subcategories")
}

// ---------- подписки ----------
model Subscription {
  id        String   @id @default(cuid())
  userId    String
  planId    String
  startDate DateTime @default(now())
  endDate   DateTime
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  plan Plan @relation(fields: [planId], references: [id])

  @@index([userId, isActive])
}

// ---------- планы ----------
model Plan {
  id            String   @id @default(cuid())
  code          String   @unique // "ONE", "FIVE", "SUB_MONTH"
  name          String
  description   String?
  priceRub      Int // цена в рублях
  type          PlanType
  periodDays    Int? // для подписки: период в днях
  creditsReward Int? // сколько баллов начислить (для SINGLE/PACKAGE)
  periodQuota   Int? // квота баллов на период подписки; null = безлимит
  createdAt     DateTime @default(now())

  subscriptions Subscription[]
}

enum PlanType {
  SUBSCRIPTION
}

// Вопросы по темам
model Question {
  id             String          @id @default(uuid())
  question       String // Текст вопроса
  options        String // JSON с вариантами ответов
  correctAnswer  Int // Индекс правильного ответа (0, 1, 2, 3)
  explanation    String? // Объяснение правильного ответа
  difficulty     Difficulty      @default(MEDIUM) // Сложность вопроса
  interviewLevel InterviewLevel? // Уровень для мок-собеседования
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  // Связи
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  subcategoryId String?
  subcategory   Subcategory? @relation(fields: [subcategoryId], references: [id])

  userAnswers UserAnswer[]

  @@map("questions")
}

// Прогресс пользователя по категориям
model UserProgress {
  id             String    @id @default(uuid())
  score          Int       @default(0) // Количество правильных ответов
  totalQuestions Int       @default(0) // Общее количество вопросов
  accuracy       Float     @default(0) // Точность (score / totalQuestions)
  level          UserLevel @default(BEGINNER) // Уровень пользователя
  startedAt      DateTime  @default(now())
  lastStudied    DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Связи
  userId String
  user   User   @relation(fields: [userId], references: [id])

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  subcategoryId String?
  subcategory   Subcategory? @relation(fields: [subcategoryId], references: [id])

  @@unique([userId, categoryId, subcategoryId])
  @@map("user_progress")
}

// Ответы пользователей на вопросы
model UserAnswer {
  id             String   @id @default(uuid())
  selectedAnswer Int // Выбранный вариант ответа
  isCorrect      Boolean // Правильный ли ответ
  timeSpent      Int? // Время на ответ в секундах
  createdAt      DateTime @default(now())

  // Связи
  userId String
  user   User   @relation(fields: [userId], references: [id])

  questionId String
  question   Question @relation(fields: [questionId], references: [id])

  @@map("user_answers")
}

// Типы программ обучения
enum ProgramType {
  MOCK_INTERVIEW // Мок-собеседование
  TOPIC_STUDY // Изучение по темам
}

// Уровни сложности вопросов
enum Difficulty {
  EASY // Лёгкий
  MEDIUM // Средний
  HARD // Сложный
  EXPERT // Экспертный
}

// Уровни собеседования
enum InterviewLevel {
  JUNIOR // Junior
  MIDDLE // Middle
  SENIOR // Senior
}

// Уровни пользователя
enum UserLevel {
  BEGINNER // Начинающий
  INTERMEDIATE // Средний
  ADVANCED // Продвинутый
  EXPERT // Экспертный
}
