// ---------- base ----------
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ---------- users ----------
model User {
  id         String   @id @default(cuid())
  telegramId String   @unique
  username   String?
  firstName  String?
  lastName   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // кошелек и история
  wallet     Wallet?
  creditTxns CreditTransaction[]

  // коммерция
  orders        Order[]
  subscriptions Subscription[]
  readings      Reading[]
}

// ---------- планы ----------
model Plan {
  id            String   @id @default(cuid())
  code          String   @unique // "ONE", "FIVE", "SUB_MONTH"
  name          String
  description   String?
  priceRub      Int // цена в рублях
  type          PlanType
  periodDays    Int? // для подписки: период в днях
  creditsReward Int? // сколько баллов начислить (для SINGLE/PACKAGE)
  periodQuota   Int? // квота баллов на период подписки; null = безлимит
  createdAt     DateTime @default(now())

  orders        Order[]
  subscriptions Subscription[]
}

enum PlanType {
  SINGLE // 1 расклад => списать 1 балл
  PACKAGE // пакет баллов => начислить N
  SUBSCRIPTION // подписка на период (безлимит или с квотой)
}

// ---------- платежи ----------
model Order {
  id         String      @id @default(cuid())
  userId     String
  planId     String
  amountRub  Int
  status     OrderStatus @default(PENDING)
  provider   Provider    @default(YOOMONEY)
  paymentId  String? // id транзакции в провайдере
  paymentUrl String? // ссылка на оплату
  meta       Json?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id])
  plan Plan @relation(fields: [planId], references: [id])

  creditTxns CreditTransaction[]
}

enum OrderStatus {
  PENDING
  PAID
  CANCELED
  EXPIRED
}

enum Provider {
  YOOMONEY
  TINKOFF
  TELEGRAM_STARS
}

// ---------- подписки ----------
model Subscription {
  id        String   @id @default(cuid())
  userId    String
  planId    String
  startDate DateTime @default(now())
  endDate   DateTime
  isActive  Boolean  @default(true)
  autoRenew Boolean  @default(false)
  provider  Provider @default(YOOMONEY)
  createdAt DateTime @default(now())

  // если есть periodQuota в плане, удобно хранить прогресс
  periodUsed Int @default(0)

  user User @relation(fields: [userId], references: [id])
  plan Plan @relation(fields: [planId], references: [id])

  @@index([userId, isActive])
}

// ---------- кошелек и транзакции баллов ----------
model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Int      @default(0) // текущее количество баллов
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model CreditTransaction {
  id        String        @id @default(cuid())
  userId    String
  orderId   String? // пополнение после оплаты
  readingId String? // списание за расклад
  type      CreditTxnType
  amount    Int // +N или -N
  reason    String?
  createdAt DateTime      @default(now())

  user    User     @relation(fields: [userId], references: [id])
  order   Order?   @relation(fields: [orderId], references: [id])
  reading Reading? @relation(fields: [readingId], references: [id])

  @@index([userId, createdAt])
}

enum CreditTxnType {
  TOPUP // начисление баллов (пакет, промо)
  CONSUME // списание баллов (расклад)
  ADJUST // ручная коррекция
  EXPIRE // сгорание
}

// ---------- учёт раскладов ----------
model Reading {
  id         String   @id @default(cuid())
  userId     String
  topic      String?
  requestMsg String?
  resultMsg  String?
  createdAt  DateTime @default(now())

  user              User                @relation(fields: [userId], references: [id])
  CreditTransaction CreditTransaction[]
}
